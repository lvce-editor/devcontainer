{
  "name": "@lvce-editor/devcontainer-monorepo",
  "version": "0.0.0-dev",
  "keywords": [
    "lvce-editor",
    "devcontainer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lvce-editor/devcontainer.git"
  },
  "license": "MIT",
  "author": "Lvce Editor",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "packages/devcontainer-worker/src/devcontainerWorkerMain.ts",
  "bin": {
    "devcontainer-worker": "bin/devcontainerWorker.js"
  },
  "scripts": {
    "build": "node packages/build/src/build.ts",
    "build:watch": "npm run build:watch --workspace=packages/build",
    "dev": "node packages/build/src/dev.ts",
    "e2e:devcontainer": "npm run e2e:headless --prefix packages/e2e",
    "format": "prettier --write .",
    "lint": "eslint . && knip --no-config-hints",
    "test": "npm test --workspaces --if-present",
    "type-check": "tsc -b"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  },
  "devDependencies": {
    "@lvce-editor/eslint-config": "^18.9.0",
    "@types/node": "^24.2.0",
    "eslint": "^10.10.0",
    "knip": "^6.34.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
