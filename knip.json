{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["bin/*.js"],
      "project": ["*.js", "bin/*.js"],
      "ignore": ["bin/devcontainerWorker.js"]
    },
    "packages/build": {
      "entry": ["src/build.ts", "src/computeNodeModulesCacheKey.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/devcontainer-node": {
      "entry": [
        "bin/*.js",
        "src/devcontainerNodeMain.ts",
        "src/parts/DevContainerCli/DevContainerCli.ts",
        "test/**/*.test.ts"
      ],
      "project": ["bin/*.js", "src/**/*.{ts,d.ts}", "test/**/*.ts"]
    },
    "packages/devcontainer-worker": {
      "entry": [
        "bin/*.js",
        "src/devcontainerProcess.ts",
        "src/devcontainerWorkerMain.ts",
        "src/devcontainerWorkerModule.ts",
        "test/**/*.test.ts"
      ],
      "project": ["bin/*.js", "src/**/*.ts", "test/**/*.ts"]
    },
    "packages/e2e": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts", "helpers/**/*.ts"]
    },
    "packages/extension": {
      "entry": ["src/devcontainerMain.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/memory": {
      "entry": ["src/measureMemory.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/server": {
      "entry": ["src/postinstall.js"],
      "project": ["src/**/*.js"],
      "ignoreDependencies": ["@lvce-editor/server"]
    },
    "packages/playground": {
      "entry": [
        "src/app.ts",
        "src/runtime-worker.ts",
        "scripts/*.js",
        "test/**/*.ts",
        "playwright.config.ts",
        "public/isolation.js"
      ],
      "project": ["src/**/*.ts", "scripts/*.js", "test/**/*.ts", "public/*.js"],
      "ignoreDependencies": ["coi-serviceworker"],
      "playwright": false
    }
  }
}
