{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "test",
    "playwright.config.ts",
    "full-stack/src",
    "full-stack/test",
    "full-stack/playwright.config.ts",
    "hosting.config.ts"
  ]
}
