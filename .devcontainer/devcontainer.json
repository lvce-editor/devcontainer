{
  "name": "devcontainer",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:26",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:4": { "moby": false }
  },
  "postCreateCommand": "npm ci",
  "postStartCommand": "nohup npm run dev > /tmp/lvce-devcontainer-server.log 2>&1 < /dev/null &",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  },
  "forwardPorts": [3000],
  "remoteUser": "node"
}
